# Supabase → Project Settings → API  (local `supabase start` prints these too)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY — never expose. Used for creating users and the cron job.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Protects /api/cron/invoices (Vercel sends it automatically as a Bearer token)
CRON_SECRET=change-me-to-a-long-random-string
# Optional: forward due/overdue reminders to a WhatsApp/SMS gateway (receives JSON via POST)
# NOTIFY_WEBHOOK_URL=
